   HEALTH
   ========================================================= */

router.get(
  "/health",
  (req, res) => {

    res.json({

      status:
        "ok",

      service:
        "TikTok Intelligence Reporting Queue",

      queueRunning:
        reportingQueue.running,

      automaticSubmission:
        CONFIG.automaticSubmission,

      humanReviewRequired:
        CONFIG.requireHumanReview,

      maxConcurrentJobs:
        CONFIG.maxConcurrentJobs,

      queueDepth:
        reportingQueue.queue.length,

      activeWorkers:
        reportingQueue.activeWorkers,

      timestamp:
